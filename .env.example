# Copy to .env.local. Never commit real values.

# Playwright: run the e2e suite against a deployed URL instead of a local build.
# E2E_BASE_URL=https://your-preview.vercel.app

# Contact form (Resend). Without these, the form shows a "not switched on yet" message.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=            # where messages are delivered (kept out of the public repo)
# CONTACT_FROM_EMAIL=          # optional; defaults to Resend's onboarding sender
# CONTACT_DELIVERY=log         # local dev / e2e only: log instead of sending. Never set on Vercel.

# Chatbot (phase 4, not used yet)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# CHAT_SESSION_SECRET=
