{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "caseStudies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "tags": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "approach": {
            "type": "string",
            "minLength": 1
          },
          "stack": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "quick": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "pdf": {
            "type": "string"
          },
          "placeholder": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "slug",
          "title",
          "summary",
          "tags",
          "role",
          "problem",
          "approach",
          "stack",
          "outcome",
          "quick",
          "pdf"
        ],
        "additionalProperties": false
      }
    },
    "audiences": {
      "minItems": 2,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "accent": {
            "type": "string",
            "enum": [
              "violet",
              "blue",
              "teal",
              "pink",
              "gold"
            ]
          },
          "contactTopic": {
            "type": "string",
            "enum": [
              "role",
              "project",
              "feedback",
              "hello"
            ]
          },
          "headline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "intro": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "string",
                "minLength": 1
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "featured": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "label",
          "accent",
          "contactTopic",
          "headline",
          "intro",
          "featured"
        ],
        "additionalProperties": false
      }
    },
    "pdfs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "publishedAt",
    "caseStudies",
    "audiences",
    "pdfs"
  ],
  "additionalProperties": false
}
